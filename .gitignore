# ═══════════════════════════════════════════════════════════════
#  ARGOS SiViA — Control de Versiones (.gitignore)
# ═══════════════════════════════════════════════════════════════

# ── 1. Python y Entornos Virtuales ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
vision_env/
backend_env/
build/
dist/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ── 2. Archivos de Entorno y Configuración Sensible ─────────────────────────
# (¡NUNCA SUBIR AL REPOSITORIO!)
.env
.env.*
!.env.example
.ngrok_token
.ngrok_url_actual
*.pem
*.key
*.crt
*.pfx
*.p12

# ── 3. Modelos de Inteligencia Artificial (Pesos Binarios Pesados) ──────────
# Descargar con: pip install ultralytics && yolo download
*.pt
*.pth
*.onnx
*.weights
*.caffemodel
*.tflite
*.bin
*.h5
*.keras
*.engine
*.safetensors

# ── 4. Datos de Entrenamiento y Ejecuciones YOLO ────────────────────────────
# Las carpetas de dataset y runs se generan localmente
runs/
backend/core_ia/athena/dataset/images/
backend/core_ia/athena/dataset/labels/
backend/core_ia/athena/runs/

# ── 5. Bases de Datos Locales ───────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
database/*.db

# ── 6. Videos y Archivos Multimedia Subidos (Uploads) y Evidencias ───────────
backend/uploads/videos/*
!backend/uploads/videos/.gitkeep
backend/evidence/*
!backend/evidence/.gitkeep
backend/core_ia/athena/evidence/*
!backend/core_ia/athena/evidence/.gitkeep
!backend/core_ia/athena/evidence/*.py
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.flv
*.m4v

# ── 7. Dependencias Node.js y Builds de Frontend ────────────────────────────
node_modules/
frontend-hermes/node_modules/
frontend-hermes/dist/*
!frontend-hermes/dist/hermes-widget.js
frontend-hermes/.vite/
dist/
dist-ssr/
*.local

# ── 8. Pruebas, Cobertura y Caches ──────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ── 9. Carpetas y Módulos Experimentales Excluidos ──────────────────────────
# Scripts de instalación (solo para distribución, no para desarrollo)
installer/
# Prototipos y maquetas frontend experimentales (no son modelos IA)
modelos_nuevos/
# Tests locales (no hacen parte del repositorio académico principal)
tests/
!tests/
tests/*
!tests/test_transmilenio_catalog_aliases.py
!tests/test_transmilenio_schematic_map.py
!tests/test_transmilenio_layout_geometry.py
!tests/test_transmilenio_tooltip.js
!tests/test_transmilenio_browser.js

# ── 10. Logs y Archivos de Diagnóstico de Ejecución ─────────────────────────
logs/
*.log
athena_worker.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.seed

# ── 11. Editor, IDEs y Herramientas ─────────────────────────────────────────
.vscode/
.idea/
.history/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── 12. Sistema Operativo ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 13. Backups, Copias Locales y Temporales ────────────────────────────────
Copias/
copias/
*.bak
*.tmp
*.temp
*~
*.orig
*.rej
*.zip
*.tar
*.gz
*.rar
*.7z

# ── 14. Archivos Temporales de Depuración y Diferencias ─────────────────────
# Archivos temporales residuales generados localmente (ej. volcados de diff)
/e
*.diff
*.patch

# ── 15. Herramientas y Agentes de Desarrollo ────────────────────────────────
.agents/
skills-lock.json

# ── 16. Documentación e informes generados localmente ───────────────────────
# La documentación técnica versionada dentro de backend/ se conserva.
/docs/
/Informe_*.md
