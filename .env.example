# ═══════════════════════════════════════════════════════════════
#  ARGOS SiViA — Variables de Entorno (.env.example)
#  Copiar este archivo como .env y rellenar los valores reales.
#  NUNCA subir el .env real a control de versiones.
# ═══════════════════════════════════════════════════════════════

# ── Fernet (cifrado del secret TOTP) ────────────────────────────────────────
# Generar una clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARGOS_FERNET_KEY=TU_CLAVE_FERNET_AQUI

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# 1. Activar verificación en 2 pasos en cuenta Gmail.
# 2. Ir a Cuenta → Seguridad → Contraseñas de aplicaciones.
# 3. Crear una contraseña para "Correo / Windows" y pégarla abajo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=email@gmail.com

# ── Modo Desarrollo ─────────────────────────────────────────────────────────
# Si = 1: NO envía emails; devuelve el código en la respuesta JSON.
# Cambiar a 0 para producción.
ARGOS_DEV_MODE=1

# ── Flask (opcional) ─────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=argos-secret-key-cambiar-en-produccion
